  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.32,
      "text": "Good morning, Vietnam!",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 2.48,
      "end": 3.78,
      "text": "Hey, this is not a test.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 4.02,
      "end": 5.5,
      "text": "This is rock and roll.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 5.86,
      "end": 8.22,
      "text": "Time to rock it from the Delta to the DMZ.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 8.44,
      "end": 10.22,
      "text": "Is that me or does that sound like an Elvis Presley movie?",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 10.56,
      "end": 11.44,
      "text": "Viva Da Nang.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 11.74,
      "end": 14.1,
      "text": "Oh, Viva Da Nang.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 14.36,
      "end": 14.8,
      "text": "Da Nang me.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 14.96,
      "end": 15.52,
      "text": "Da Nang me.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 15.64,
      "end": 17.16,
      "text": "We're going to get a rope and hang me.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 17.16,
      "end": 19.3,
      "text": "Hey, is it a little too early for being that loud?",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 19.42,
      "end": 20.3,
      "text": "Hey, too late.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 20.66,
      "end": 21.5,
      "text": "It's 0600.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 21.64,
      "end": 22.5,
      "text": "What's the O stand for?",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 22.62,
      "end": 23.98,
      "text": "Oh my God, it's early.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 24.08,
      "end": 24.62,
      "text": "Speaking of early.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 24.92,
      "end": 26.46,
      "text": "How about that Cro-Magnon, Marty Drywood?",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 26.54,
      "end": 28.0,
      "text": "Thank you, Marty, for silky smooth sound.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 28.06,
      "end": 29.04,
      "text": "Make me sound like Peggy Lee.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 29.22,
      "end": 30.82,
      "text": "Freddy and the Dreamers.",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 34.17,
      "end": 35.57,
      "text": "Over wrong speed.",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 35.77,
      "end": 37.69,
      "text": "We've got it on the wrong speed.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 38.03,
      "end": 40.35,
      "text": "For those of you who are recovering from a hangover,",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 40.45,
      "end": 41.93,
      "text": "that's going to sound just right.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 42.21,
      "end": 43.27,
      "text": "Let's pull it right back down again.",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 43.37,
      "end": 43.99,
      "text": "Let's try a little faster.",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 44.09,
      "end": 44.91,
      "text": "See if that picks it up a little bit.",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 45.13,
      "end": 46.07,
      "text": "Let's get up on...",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 48.57,
      "end": 49.59,
      "text": "Those pilots are gone right now.",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 49.63,
      "end": 50.83,
      "text": "I really like the music.",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 51.45,
      "end": 52.83,
      "text": "Oh, still a bad song.",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 52.91,
      "end": 53.33,
      "text": "Hey, wait a minute.",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 53.55,
      "end": 54.11,
      "text": "Let's try something.",
      "filename": "segment033.mp4"
    },
    {
      "index": 34,
      "start": 54.45,
      "end": 56.31,
      "text": "Let's play this backwards and see if it gets any better.",
      "filename": "segment034.mp4"
    },
    {
      "index": 35,
      "start": 57.63,
      "end": 58.37,
      "text": "Freddy is a devil.",
      "filename": "segment035.mp4"
    },
    {
      "index": 36,
      "start": 58.65,
      "end": 59.99,
      "text": "Freddy is a devil.",
      "filename": "segment036.mp4"
