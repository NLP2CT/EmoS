  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 4.1,
      "text": "How does it always happen that all of the idiots are always on your team?",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 4.24,
      "end": 7.16,
      "text": "How can you refuse to fund my research?",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 7.32,
      "end": 9.96,
      "text": "Or not invite me to participate in yours?",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 10.5,
      "end": 15.66,
      "text": "Your National Institutes of Health received my first request for money two years ago.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 16.38,
      "end": 19.16,
      "text": "It took you one year just to print up application forms.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 19.76,
      "end": 23.92,
      "text": "It's taken you three years for my first reported case just to show up here for a look.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 24.04,
      "end": 27.72,
      "text": "And the paltry amount of money you are forcing us to beg for",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 27.72,
      "end": 32.42,
      "text": "out of the four billion dollars you now receive each and every year",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 32.42,
      "end": 36.18,
      "text": "to protect the health of the American people",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 36.18,
      "end": 39.14,
      "text": "won't come to anyone before only God knows when.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 39.14,
      "end": 41.92,
      "text": "A promising virus has been discovered in France.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 42.2,
      "end": 44.0,
      "text": "Why do you refuse to cooperate with the French?",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 44.26,
      "end": 47.36,
      "text": "Why are we told not to cooperate with the French?",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 47.62,
      "end": 51.0,
      "text": "Just so you can steal a Nobel Prize while something is being",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 51.54,
      "end": 53.66,
      "text": "passed around that causes death.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 56.0,
      "end": 57.8,
      "text": "Women have been discovered to have it in Africa",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 57.8,
      "end": 60.58,
      "text": "where it is clearly transmitted heterosexually.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 60.68,
      "end": 62.52,
      "text": "It is only a question of time.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 62.74,
      "end": 65.22,
      "text": "We could all be dead before you do anything.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 65.46,
      "end": 66.2,
      "text": "You want my data?",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 66.66,
      "end": 67.56,
      "text": "You want my ideas?",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 67.88,
      "end": 68.64,
      "text": "You want my papers?",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 69.0,
      "end": 69.56,
      "text": "Take them!",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 69.56,
      "end": 71.52,
      "text": "Just do something with them!",
      "filename": "segment024.mp4"
    }
  ]
}