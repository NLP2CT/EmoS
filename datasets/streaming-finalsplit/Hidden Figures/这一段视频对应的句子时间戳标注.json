  "clip": "Hidden Figures.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.54,
      "text": "Now where the hell do you go every day?",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 4.88,
      "end": 6.32,
      "text": "To the bathroom, sir.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 6.72,
      "end": 7.34,
      "text": "The bathroom.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 8.92,
      "end": 10.34,
      "text": "To the damn bathroom.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 11.44,
      "end": 12.58,
      "text": "For 40 minutes a day?",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 15.18,
      "end": 16.36,
      "text": "What are you doing now?",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 17.98,
      "end": 19.24,
      "text": "We're T minus zero here.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 19.28,
      "end": 20.42,
      "text": "I put a lot of faith in you.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 22.86,
      "end": 24.66,
      "text": "There's no bathroom for me here.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 26.0,
      "end": 28.08,
      "text": "What do you mean there's no bathroom for you here?",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 28.12,
      "end": 29.56,
      "text": "There is no bathroom.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 30.52,
      "end": 33.14,
      "text": "There are no colored bathrooms in this building.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 33.38,
      "end": 35.48,
      "text": "Or any building outside the west campus.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 35.56,
      "end": 36.74,
      "text": "We're just half a mile away.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 37.38,
      "end": 38.04,
      "text": "Did you know that?",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 39.5,
      "end": 42.66,
      "text": "I have to walk to Timbuktu just to relieve myself.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 43.34,
      "end": 45.22,
      "text": "And I can't use one of the handy bikes.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 45.22,
      "end": 46.96,
      "text": "Picture that, Mr. Harrison.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 47.9,
      "end": 48.96,
      "text": "My uniform.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 49.7,
      "end": 50.98,
      "text": "Skirt below my knees.",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 51.14,
      "end": 51.98,
      "text": "My heels.",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 52.24,
      "end": 53.7,
      "text": "And a simple string of pearls.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 53.8,
      "end": 55.26,
      "text": "Well, I don't own pearls.",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 55.58,
      "end": 58.68,
      "text": "Lord knows you don't pay colors enough to afford pearls.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 59.6,
      "end": 62.08,
      "text": "And I work like a dog.",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 62.22,
      "end": 63.54,
      "text": "Day and night.",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 64.28,
      "end": 67.9,
      "text": "Living off a coffee from a pot none of you want to touch.",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 80.4,
      "end": 82.68,
      "text": "So, excuse me.",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 83.32,
      "end": 86.16,
      "text": "If I have to go to the restroom a few times a day.",
      "filename": "segment029.mp4"
    }
  ]
}