  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 2.18,
      "text": "你们永远都不会承认自己做过的什么,",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 8.92,
      "end": 15.34,
      "text": "我怎么不记得我把红果水丢到他身上",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 16.3,
      "end": 18.08,
      "text": "我就是那个时候玩的呀",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 19.6,
      "end": 20.44,
      "text": "还有你",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 21.54,
      "end": 24.56,
      "text": "你会说我没有为他吃过垃圾",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 24.56,
      "end": 26.22,
      "text": "没有泡过他冷水",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 26.68,
      "end": 28.08,
      "text": "没有扒过他衣服",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 31.5,
      "end": 33.04,
      "text": "你们之后的日子",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 33.04,
      "end": 33.5,
      "text": "我都会记得",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 34.62,
      "end": 35.82,
      "text": "舒舒坦坦",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 36.4,
      "end": 37.98,
      "text": "没有一点犀利负担",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 38.52,
      "end": 39.98,
      "text": "你们回首自己的人生",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 42.64,
      "end": 44.72,
      "text": "觉得自己挺好的了",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 44.72,
      "end": 47.6,
      "text": "觉得自己没有做过什么伤天害理的事",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 49.64,
      "end": 50.92,
      "text": "太恶心了",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 51.56,
      "end": 53.42,
      "text": "实在是太恶心了",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 53.42,
      "end": 54.92,
      "text": "她不是认真的吗",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 55.78,
      "end": 57.48,
      "text": "如果我永远忘不掉",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 58.88,
      "end": 60.08,
      "text": "如果我忘不掉",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 61.3,
      "end": 62.68,
      "text": "怎么被你们欺负",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 64.26,
      "end": 65.62,
      "text": "怎么被你们侮辱",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 67.74,
      "end": 69.96,
      "text": "粉笔灰塞嘴里是什么滋味",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 72.22,
      "end": 74.8,
      "text": "打我几梢头发是什么滋味",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 75.58,
      "end": 79.42,
      "text": "被你们一口一个一口一个喊杀人凶手是什么滋味",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 80.02,
      "end": 82.36,
      "text": "如果我永远忘不掉",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 82.96,
      "end": 84.7,
      "text": "你们也别想忘掉",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 85.32,
      "end": 86.98,
      "text": "你们骂过我最难听的词",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 87.48,
      "end": 89.26,
      "text": "编过最下流的称号",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 91.6,
      "end": 94.18,
      "text": "你们动手的没动手的都一样",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 94.94,
      "end": 96.86,
      "text": "你们比石头还冷吗",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 98.08,
      "end": 99.82,
      "text": "你们又恶毒又愚蠢",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 99.82,
      "end": 101.08,
      "text": "你们胆小怕事",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 101.08,
      "end": 102.94,
      "text": "别人做什么你们就跟着做什么",
      "filename": "segment033.mp4"
    },
    {
      "index": 34,
      "start": 102.94,
      "end": 104.78,
      "text": "你们巴不得世界上多死一个人",
      "filename": "segment034.mp4"
    },
    {
      "index": 35,
      "start": 104.78,
      "end": 106.56,
      "text": "因为你们的日子真的无聊",
      "filename": "segment035.mp4"
    },
    {
      "index": 36,
      "start": 107.06,
      "end": 110.12,
      "text": "因为你们觉得自己不会承担任何后果",
      "filename": "segment036.mp4"
    },
    {
      "index": 37,
      "start": 112.52,
      "end": 114.2,
      "text": "杀死顾心香的凶手",
      "filename": "segment037.mp4"
    },
    {
      "index": 38,
      "start": 115.9,
      "end": 116.9,
      "text": "不知道是谁",
      "filename": "segment038.mp4"
    },
    {
      "index": 39,
      "start": 121.88,
      "end": 123.6,
      "text": "他杀死我们的凶手",
      "filename": "segment039.mp4"
    },
    {
      "index": 40,
      "start": 125.62,
      "end": 127.22,
      "text": "你们知道是谁",
      "filename": "segment040.mp4"
    },
    {
      "index": 41,
      "start": 128.8,
      "end": 130.46,
      "text": "是杰伦哥哥",
      "filename": "segment041.mp4"
    },
    {
      "index": 42,
      "start": 130.46,
      "end": 131.5,
      "text": "一鹤",
      "filename": "segment042.mp4"
    }
