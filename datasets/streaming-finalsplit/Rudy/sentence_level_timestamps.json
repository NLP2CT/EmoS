{
  "lang": "en",
  "film": "Rudy",
  "source_rel": "Greatest Acting Monologues Of All Time PART 2/Greatest Acting Monologues Of All Time PART 2.mp4",
  "t_start_global": 1496.32,
  "t_end_global": 1580.08,
  "duration": 83.76,
  "clip": "Rudy.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 5.79,
      "text": "To prove to everyone that I was somebody.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 5.95,
      "end": 7.63,
      "text": "Oh, you are so full of crap.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 9.47,
      "end": 12.91,
      "text": "You're five feet nothing, a hundred and nothing.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 13.69,
      "end": 15.91,
      "text": "And you got hardly a speck of athletic ability.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 16.39,
      "end": 20.39,
      "text": "And you hung in with the best college football team in the land for two years.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 21.07,
      "end": 25.21,
      "text": "And you're also going to walk out of here with a degree from the University of Notre Dame.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 25.95,
      "end": 29.73,
      "text": "In this lifetime, you don't have to prove nothing to nobody except yourself.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 30.83,
      "end": 34.33,
      "text": "And after what you've gone through, if you haven't done that by now,",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 35.15,
      "end": 36.73,
      "text": "it ain't going to never happen.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 41.67,
      "end": 42.77,
      "text": "Now, go on back.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 46.88,
      "end": 49.14,
      "text": "I'm sorry I never got you to see your first game in here.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 52.64,
      "end": 54.92,
      "text": "Hell, I've seen too many games in this stadium.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 56.06,
      "end": 57.54,
      "text": "I thought you said you never saw games.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 57.54,
      "end": 59.24,
      "text": "I've never seen a game from the stands.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 60.68,
      "end": 61.8,
      "text": "You were a player?",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 64.2,
      "end": 66.34,
      "text": "I rode the bench for two years.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 67.94,
      "end": 70.42,
      "text": "Thought I wasn't being played because of my color.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 70.52,
      "end": 73.64,
      "text": "I got filled up with a lot of attitude, so I quit.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 75.18,
      "end": 77.74,
      "text": "Still not a week goes by I don't regret it.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 78.28,
      "end": 81.4,
      "text": "And I guarantee a week won't go by in your life you won't regret",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 81.4,
      "end": 83.76,
      "text": "walking out letting them get the best of you.",
      "filename": "segment021.mp4"
    }
  ]
}