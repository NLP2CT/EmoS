    },
    {
      "index": 9,
      "start": 17.78,
      "end": 19.44,
      "text": "I've heard all of your platitudes.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 19.78,
      "end": 20.46,
      "text": "I got them.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 20.52,
      "end": 20.88,
      "text": "I know.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 21.18,
      "end": 22.46,
      "text": "She's in a better place.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 22.72,
      "end": 25.1,
      "text": "And this is all a part of a master plan.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 25.66,
      "end": 26.5,
      "text": "I heard that one too.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 27.06,
      "end": 27.64,
      "text": "Here's my favorite.",
