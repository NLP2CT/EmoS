  "clip": "Head of State.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 6.459,
      "text": "You know, they had a speech written for me",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 8.339,
      "end": 9.94,
      "text": "about what the people need.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 10.76,
      "end": 12.039,
      "text": "But you guys are the people.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 13.14,
      "end": 14.48,
      "text": "You know what you need.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 15.62,
      "end": 16.66,
      "text": "Better schools.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 17.98,
      "end": 19.02,
      "text": "Better jobs.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 20.14,
      "end": 20.82,
      "text": "Less crime.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 23.62,
      "end": 26.08,
      "text": "How many of you right now",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 26.8,
      "end": 28.24,
      "text": "work two jobs",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 28.24,
      "end": 30.22,
      "text": "just to have enough money",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 30.22,
      "end": 31.68,
      "text": "to be broke?",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 32.539,
      "end": 32.98,
      "text": "That ain't right.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 34.7,
      "end": 36.02,
      "text": "If you work two jobs",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 36.02,
      "end": 37.58,
      "text": "and at the end of the week",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 37.58,
      "end": 39.52,
      "text": "you got just enough money",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 39.52,
      "end": 41.44,
      "text": "to get your broke ass home",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 41.44,
      "end": 43.9,
      "text": "let me hear you say, that ain't right.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 47.1,
      "end": 48.539,
      "text": "How many of you",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 48.539,
      "end": 49.78,
      "text": "have children",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 50.48,
      "end": 51.94,
      "text": "that they call stupid?",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 52.16,
      "end": 53.2,
      "text": "Don't be ashamed.",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 53.82,
      "end": 54.64,
      "text": "It ain't your fault.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 55.12,
      "end": 57.18,
      "text": "I asked my niece the other day, what's 4 plus 4?",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 57.4,
      "end": 58.36,
      "text": "She said 44.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 59.039,
      "end": 62.08,
      "text": "So that ain't her fault, that's the school's fault.",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 62.78,
      "end": 64.36,
      "text": "Now if your child's school",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 64.36,
      "end": 66.499,
      "text": "has old ass books",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 66.499,
      "end": 68.18,
      "text": "and brand new metal detectors",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 68.18,
      "end": 70.26,
      "text": "let me hear you say, that ain't right.",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 71.76,
      "end": 72.76,
      "text": "It ain't right.",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 73.419,
      "end": 75.56,
      "text": "And now we got these corporations",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 76.6,
      "end": 77.94,
      "text": "stealing all the money.",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 78.339,
      "end": 79.499,
      "text": "They stealing their money,",
      "filename": "segment033.mp4"
    },
    {
      "index": 34,
      "start": 79.56,
      "end": 80.6,
      "text": "they stealing our money.",
      "filename": "segment034.mp4"
    },
    {
      "index": 35,
      "start": 81.419,
      "end": 81.98,
      "text": "The pension.",
      "filename": "segment035.mp4"
    },
    {
      "index": 36,
      "start": 82.62,
      "end": 84.56,
      "text": "You worked for 35 years.",
      "filename": "segment036.mp4"
    },
    {
      "index": 37,
      "start": 84.8,
      "end": 86.999,
      "text": "You thought you was going to leave your kids a will,",
      "filename": "segment037.mp4"
    },
    {
      "index": 38,
      "start": 87.2,
      "end": 88.76,
      "text": "now you're going to leave them a won't.",
      "filename": "segment038.mp4"
    },
    {
      "index": 39,
      "start": 89.2,
      "end": 90.879,
      "text": "You show up to get your pension,",
      "filename": "segment039.mp4"
    },
    {
      "index": 40,
      "start": 91.24,
      "end": 92.32,
      "text": "they give you a pen.",
      "filename": "segment040.mp4"
    },
    {
      "index": 41,
      "start": 93.08,
      "end": 94.26,
      "text": "Give you a damn pen.",
      "filename": "segment041.mp4"
    },
    {
      "index": 42,
      "start": 94.32,
      "end": 97.24,
      "text": "Now what the hell am I supposed to do with a pen?",
      "filename": "segment042.mp4"
    },
    {
      "index": 43,
      "start": 97.52,
      "end": 99.82,
      "text": "I should just stab you in the neck with this pen.",
      "filename": "segment043.mp4"
    },
    {
      "index": 44,
      "start": 100.02,
      "end": 101.16,
      "text": "Mr. Pension taker.",
      "filename": "segment044.mp4"
    }
  ]
}