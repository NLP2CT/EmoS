{
  "lang": "en",
  "film": "Fences",
  "source_rel": "Greatest Acting Monologues Of All Time PART 2/Greatest Acting Monologues Of All Time PART 2.mp4",
  "t_start_global": 2006.9,
  "t_end_global": 2101.06,
  "duration": 94.16,
  "clip": "Fences.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.66,
      "text": "I've been right here with you, Troy.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 2.3,
      "end": 3.5,
      "text": "I got a life too.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 4.28,
      "end": 7.76,
      "text": "I gave 18 years of my life to stand in the same spot as you.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 8.48,
      "end": 10.3,
      "text": "Don't you think I ever wanted other things?",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 10.7,
      "end": 12.5,
      "text": "Don't you think I had dreams and hopes?",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 12.78,
      "end": 13.72,
      "text": "What about my life?",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 13.76,
      "end": 14.44,
      "text": "What about me?",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 15.56,
      "end": 17.14,
      "text": "Don't you think I ever crossed my mind and wanted to be a better person?",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 17.86,
      "end": 22.2,
      "text": "That I wanted to lay up somewhere and forget about my responsibilities?",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 22.62,
      "end": 25.74,
      "text": "That I wanted someone to make me laugh so I could feel good?",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 26.4,
      "end": 28.28,
      "text": "You're not the only one who's got wants and needs.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 28.74,
      "end": 29.78,
      "text": "But hold on to your, Troy.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 30.5,
      "end": 36.56,
      "text": "I took all my feelings, my wants and needs and dreams and I buried them inside you.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 36.84,
      "end": 39.02,
      "text": "I planted a seed and watched and prayed over.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 39.14,
      "end": 41.88,
      "text": "I planted myself inside you and waited to bloom.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 42.339,
      "end": 45.94,
      "text": "It didn't take me no 18 years to realize the soil was hard and rocky",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 45.94,
      "end": 47.46,
      "text": "and it was never gonna bloom.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 48.239,
      "end": 49.42,
      "text": "But I held on to you, Troy.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 49.759,
      "end": 50.88,
      "text": "I held you tighter.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 51.48,
      "end": 52.339,
      "text": "You was my husband.",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 53.339,
      "end": 58.12,
      "text": "I owed you everything I had, every part of me I could find to give you.",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 58.779,
      "end": 62.0,
      "text": "And upstairs in that bedroom with the darkness falling in on me,",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 62.9,
      "end": 68.14,
      "text": "I gave everything I had to try and erase the doubt that you wasn't the",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 68.14,
      "end": 70.94,
      "text": "finest man in the world and wherever you was going,",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 71.04,
      "end": 73.7,
      "text": "I was gonna be there with you because you was my husband.",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 76.1,
      "end": 79.279,
      "text": "Because that's the only way I was gonna survive is your wife.",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 80.239,
      "end": 84.239,
      "text": "You're always talking about what you give and what you don't have to give.",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 84.839,
      "end": 86.16,
      "text": "But you take too, Troy.",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 86.68,
      "end": 89.4,
      "text": "You take and don't even know nobody's giving.",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 91.64,
      "end": 94.16,
      "text": "I can't listen to this anymore.",
      "filename": "segment030.mp4"
    }
  ]
}