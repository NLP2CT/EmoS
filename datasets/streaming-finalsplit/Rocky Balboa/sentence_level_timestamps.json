{
  "lang": "en",
  "film": "Rocky Balboa",
  "source_rel": "Greatest Acting Monologues Of All Time PART 1_有史以来最伟大的表演独白 PART 1/Greatest Acting Monologues Of All Time PART 1_有史以来最伟大的表演独白 PART 1.mp4",
  "t_start_global": 346.18,
  "t_end_global": 460.66,
  "duration": 114.48,
  "clip": "Rocky Balboa.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.46,
      "text": "You ain't gonna believe this.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 2.72,
      "end": 4.3,
      "text": "But you used to fit right here.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 5.44,
      "end": 7.38,
      "text": "I'd hold you up and say to your mother,",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 7.8,
      "end": 9.68,
      "text": "this kid's gonna be the best kid in the world.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 10.42,
      "end": 13.14,
      "text": "This kid's gonna be somebody better than anybody ever knew.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 13.7,
      "end": 16.08,
      "text": "And you grew up good and wonderful.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 16.98,
      "end": 18.02,
      "text": "It was great just watching.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 18.14,
      "end": 19.42,
      "text": "Every day was like a privilege.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 20.28,
      "end": 23.54,
      "text": "Did the time come for you to be your own man and take on the world?",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 23.62,
      "end": 24.22,
      "text": "And you did.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 24.52,
      "end": 27.2,
      "text": "But somewhere along the line, you changed.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 27.8,
      "end": 29.12,
      "text": "You stopped being you.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 29.62,
      "end": 32.7,
      "text": "You let people stick a finger in your face and tell you you're no good.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 33.2,
      "end": 36.42,
      "text": "And when things got hard, you started looking for something to blame.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 36.84,
      "end": 37.92,
      "text": "Like a big shadow.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 40.64,
      "end": 42.1,
      "text": "Let me tell you something you already know.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 42.7,
      "end": 45.04,
      "text": "The world ain't all sunshine and rainbows.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 45.6,
      "end": 47.84,
      "text": "It's a very mean and nasty place.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 47.88,
      "end": 49.36,
      "text": "And I don't care how tough you are,",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 49.54,
      "end": 53.26,
      "text": "it will beat you to your knees and keep you there permanently if you let it.",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 53.76,
      "end": 57.22,
      "text": "You, me, or nobody is gonna hit as hard as life.",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 57.94,
      "end": 59.72,
      "text": "But it ain't about how hard you hit.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 60.16,
      "end": 63.76,
      "text": "It's about how hard you can get hit and keep moving forward.",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 63.84,
      "end": 66.4,
      "text": "How much you can take and keep moving forward.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 67.2,
      "end": 68.48,
      "text": "That's how winning is done.",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 69.84,
      "end": 72.82,
      "text": "Now if you know what you're worth, now go out and get what you're worth.",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 73.04,
      "end": 74.82,
      "text": "But you gotta be willing to take the hits.",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 75.18,
      "end": 79.94,
      "text": "And not pointing fingers saying you ain't where you wanna be because of him or her or anybody.",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 80.78,
      "end": 82.46,
      "text": "Cowards do that and that ain't you.",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 82.96,
      "end": 84.1,
      "text": "You're better than that.",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 91.45,
      "end": 93.49,
      "text": "I'm always gonna love you no matter what.",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 95.09,
      "end": 96.21,
      "text": "No matter what happens.",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 97.43,
      "end": 98.79,
      "text": "You're my sun and you're my blood.",
      "filename": "segment033.mp4"
    },
    {
      "index": 34,
      "start": 100.29,
      "end": 102.11,
      "text": "You're the best thing in my life.",
      "filename": "segment034.mp4"
    },
    {
      "index": 35,
      "start": 103.87,
      "end": 108.01,
      "text": "But until you start believing in yourself, you ain't gonna have a life.",
      "filename": "segment035.mp4"
    },
    {
      "index": 36,
      "start": 113.08,
      "end": 114.48,
      "text": "Don't forget to visit your mother.",
      "filename": "segment036.mp4"
    }
  ]
}