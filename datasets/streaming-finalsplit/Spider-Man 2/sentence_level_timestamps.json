{
  "lang": "en",
  "film": "Spider-Man 2",
  "source_rel": "Greatest Acting Monologues Of All Time PART 3/Greatest Acting Monologues Of All Time PART 3.mp4",
  "t_start_global": 3044.52,
  "t_end_global": 3116.92,
  "duration": 72.4,
  "clip": "Spider-Man 2.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 0.72,
      "text": "Spider-Man.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 1.52,
      "end": 1.88,
      "text": "Why?",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 2.3,
      "end": 4.6,
      "text": "Well, he knows a hero when he sees one.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 5.14,
      "end": 9.06,
      "text": "Too few characters out there flying around like that,",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 9.46,
      "end": 11.02,
      "text": "saving old girls like me.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 11.62,
      "end": 14.92,
      "text": "Lord knows kids like Henry need a hero.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 15.68,
      "end": 17.8,
      "text": "Courageous, self-sacrificing people,",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 18.48,
      "end": 20.36,
      "text": "setting examples for all of us.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 21.86,
      "end": 23.62,
      "text": "Everybody loves a hero.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 24.36,
      "end": 27.32,
      "text": "People line up for him, cheer them, scream their names,",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 27.86,
      "end": 31.44,
      "text": "and years later they'll tell how they stood in the rain for hours",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 32.11,
      "end": 36.8,
      "text": "just to get a glimpse of the one who taught him to hold on a second longer.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 38.56,
      "end": 41.48,
      "text": "I believe there's a hero in all of us",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 42.52,
      "end": 44.06,
      "text": "that keeps us honest,",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 45.12,
      "end": 46.6,
      "text": "gives us strength,",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 47.44,
      "end": 48.5,
      "text": "makes us noble,",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 50.0,
      "end": 53.18,
      "text": "and finally allows us to die with pride.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 54.7,
      "end": 58.28,
      "text": "Even though sometimes we have to be steady",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 58.28,
      "end": 61.42,
      "text": "and give up the thing we want the most.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 63.94,
      "end": 65.28,
      "text": "Even our dreams.",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 67.78,
      "end": 72.4,
      "text": "Spider-Man did that for Henry and he wonders where he's gone.",
      "filename": "segment021.mp4"
    }
  ]
}