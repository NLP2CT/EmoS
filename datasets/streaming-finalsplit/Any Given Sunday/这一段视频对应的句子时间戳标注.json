{
  "lang": "en",
  "film": "Any Given Sunday",
  "source_rel": "Greatest Acting Monologues Of All Time PART 2/Greatest Acting Monologues Of All Time PART 2.mp4",
  "t_start_global": 1245.62,
  "t_end_global": 1492.92,
  "duration": 247.3,
  "clip": "Any Given Sunday.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.92,
      "text": "I don't know what to say, really.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 5.1,
      "end": 9.76,
      "text": "Three minutes to the biggest battle of our professional lives.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 11.5,
      "end": 13.02,
      "text": "All comes down to today.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 15.52,
      "end": 21.56,
      "text": "Either we heal as a team, or we're going to crumble.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 23.2,
      "end": 27.08,
      "text": "Inch by inch, play by play, till we're finished.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 27.82,
      "end": 29.76,
      "text": "We're in hell right now, gentlemen.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 31.0,
      "end": 31.72,
      "text": "Believe me.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 33.66,
      "end": 37.4,
      "text": "And we can stay here, get the shit kicked out of us,",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 39.06,
      "end": 43.6,
      "text": "or we can fight our way back into the light.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 44.24,
      "end": 49.67,
      "text": "We can climb out of hell, one inch at a time.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 52.36,
      "end": 54.56,
      "text": "Now, I can't do it for you.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 55.12,
      "end": 56.38,
      "text": "I'm too old.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 59.1,
      "end": 62.44,
      "text": "I look around, I see these young faces, and I think,",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 63.82,
      "end": 68.7,
      "text": "I mean, I made every wrong choice a middle-aged man can make.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 71.94,
      "end": 76.42,
      "text": "I pissed away all my money, believe it or not.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 77.44,
      "end": 81.14,
      "text": "I chased off anyone who's ever loved me.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 83.43,
      "end": 88.13,
      "text": "And lately, I can't even stand the face I see in a mirror.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 92.69,
      "end": 96.97,
      "text": "You know, when you get old in life, things get taken from you.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 97.01,
      "end": 99.15,
      "text": "I mean, that's part of life.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 99.97,
      "end": 103.65,
      "text": "But you only learn that when you start losing stuff.",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 104.91,
      "end": 108.09,
      "text": "You find out life's this game of inches.",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 108.89,
      "end": 110.07,
      "text": "So is football.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 111.47,
      "end": 117.93,
      "text": "Because in either game, life or football, the margin for error is so small.",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 118.43,
      "end": 123.61,
      "text": "I mean, one half a step too late or too early, and you don't quite make it.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 124.01,
      "end": 127.67,
      "text": "One half second too slow, too fast, you don't quite catch it.",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 128.01,
      "end": 131.89,
      "text": "The inches we need are everywhere around us.",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 132.61,
      "end": 137.59,
      "text": "They're in every break of the game, every minute, every second.",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 140.05,
      "end": 143.09,
      "text": "On this team, we fight for that inch.",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 144.25,
      "end": 150.83,
      "text": "On this team, we tear ourselves and everyone else around us to pieces for that inch.",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 151.57,
      "end": 155.33,
      "text": "We claw with our fingernails for that inch.",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 155.33,
      "end": 160.39,
      "text": "Because we know when we add up all those inches,",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 160.51,
      "end": 164.99,
      "text": "that's going to make the difference between winning and losing.",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 167.27,
      "end": 169.79,
      "text": "Between living and dying.",
      "filename": "segment033.mp4"
    },
    {
      "index": 34,
      "start": 171.15,
      "end": 178.37,
      "text": "I'll tell you this, in any fight, it's the guy who's willing to die who's going to win that inch.",
      "filename": "segment034.mp4"
    },
    {
      "index": 35,
      "start": 179.33,
      "end": 181.87,
      "text": "And I know if I'm going to have any life anymore,",
      "filename": "segment035.mp4"
    },
    {
      "index": 36,
      "start": 182.45,
      "end": 186.71,
      "text": "it's because I'm still willing to fight and die for that inch.",
      "filename": "segment036.mp4"
    },
    {
      "index": 37,
      "start": 188.99,
      "end": 191.03,
      "text": "Because that's what living is.",
      "filename": "segment037.mp4"
    },
    {
      "index": 38,
      "start": 191.91,
      "end": 194.59,
      "text": "The six inches in front of your face.",
      "filename": "segment038.mp4"
    },
    {
      "index": 39,
      "start": 195.35,
      "end": 197.15,
      "text": "Now, I can't make you do it.",
      "filename": "segment039.mp4"
    },
    {
      "index": 40,
      "start": 197.77,
      "end": 201.53,
      "text": "You got to look at the guy next to you, look into his eyes.",
      "filename": "segment040.mp4"
    },
    {
      "index": 41,
      "start": 201.97,
      "end": 206.17,
      "text": "Now, I think you're going to see a guy who will go that inch with you.",
      "filename": "segment041.mp4"
    },
    {
      "index": 42,
      "start": 206.65,
      "end": 211.87,
      "text": "You're going to see a guy who will sacrifice himself for this team,",
      "filename": "segment042.mp4"
    },
    {
      "index": 43,
      "start": 212.03,
      "end": 216.79,
      "text": "because he knows when it comes down to it, you're going to do the same for him.",
      "filename": "segment043.mp4"
    },
    {
      "index": 44,
      "start": 218.43,
      "end": 220.21,
      "text": "That's a team, gentlemen.",
      "filename": "segment044.mp4"
    },
    {
      "index": 45,
      "start": 221.47,
      "end": 226.15,
      "text": "And either we heal now as a team,",
      "filename": "segment045.mp4"
    },
    {
      "index": 46,
      "start": 227.49,
      "end": 236.08,
      "text": "or we will die as individuals, as football guys.",
      "filename": "segment046.mp4"
    },
    {
      "index": 47,
      "start": 240.04,
      "end": 241.18,
      "text": "That's all it is.",
      "filename": "segment047.mp4"
    },
    {
      "index": 48,
      "start": 245.5,
      "end": 247.3,
      "text": "Now, what are you going to do?",
      "filename": "segment048.mp4"
    }
  ]
}