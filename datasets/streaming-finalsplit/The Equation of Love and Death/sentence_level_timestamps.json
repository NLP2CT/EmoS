    },
    {
      "index": 6,
      "start": 15.66,
      "end": 17.74,
      "text": "还有就是跟我谈恋爱,",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 21.46,
      "end": 22.6,
      "text": "我们都不起眼,",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 22.76,
      "end": 23.94,
      "text": "没有人在乎我们,",
