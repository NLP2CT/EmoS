    },
    {
      "index": 9,
      "start": 25.12,
      "end": 26.16,
      "text": "高考结束那天,",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 26.62,
      "end": 27.52,
      "text": "我们都很沮丧,",
