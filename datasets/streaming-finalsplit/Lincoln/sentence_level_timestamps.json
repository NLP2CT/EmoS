{
  "lang": "en",
  "film": "Lincoln",
  "source_rel": "Greatest Acting Monologues Of All Time PART 2/Greatest Acting Monologues Of All Time PART 2.mp4",
  "t_start_global": 2103.42,
  "t_end_global": 2183.76,
  "duration": 80.34,
  "clip": "Lincoln.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 8.48,
      "text": "I can't accomplish a goddamn thing of any human meaning or worth until we cure ourselves of",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 8.48,
      "end": 12.3,
      "text": "slavery and end this pestilential war.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 13.1,
      "end": 18.36,
      "text": "And whether any of you or anyone else knows it, I know I need this.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 18.96,
      "end": 21.66,
      "text": "This amendment is that cure.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 24.82,
      "end": 27.94,
      "text": "We're stepped out upon the world stage now.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 28.08,
      "end": 32.58,
      "text": "Now with the fate of human dignity in our hands.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 34.36,
      "end": 37.3,
      "text": "Blood's been spilt to afford us this moment.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 37.3,
      "end": 39.68,
      "text": "Now, now, now.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 40.16,
      "end": 45.8,
      "text": "And you growl and heckle and dodge about like petty fucking Tammany Hall hucksters.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 46.66,
      "end": 48.42,
      "text": "See what is before you.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 49.38,
      "end": 51.18,
      "text": "See the here and now.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 51.32,
      "end": 53.18,
      "text": "That's the hardest thing.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 53.5,
      "end": 55.08,
      "text": "The only thing that accounts.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 57.42,
      "end": 65.38,
      "text": "Abolishing slavery by constitutional provision settles the fate for all coming time.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 66.34,
      "end": 74.64,
      "text": "Not only of the millions now in bondage, but of unborn millions to come.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 75.72,
      "end": 78.24,
      "text": "Two votes stand in its way.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 78.68,
      "end": 80.34,
      "text": "These votes must be procured.",
      "filename": "segment017.mp4"
    }
  ]
}