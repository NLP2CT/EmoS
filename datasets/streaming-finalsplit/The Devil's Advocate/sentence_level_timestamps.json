  "clip": "The Devil's Advocate.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 3.68,
      "text": "Let me give you a little inside information about God.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 4.4,
      "end": 5.98,
      "text": "God likes to watch.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 6.38,
      "end": 7.32,
      "text": "He's a prankster.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 7.9,
      "end": 8.7,
      "text": "Think about it.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 9.66,
      "end": 12.18,
      "text": "He gives man instincts.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 13.62,
      "end": 16.14,
      "text": "He gives you this extraordinary gift.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 16.32,
      "end": 17.22,
      "text": "And then what does he do?",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 17.32,
      "end": 24.56,
      "text": "I swear for his own amusement, his own private cosmic gag reel.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 25.38,
      "end": 27.58,
      "text": "He sets the rules in opposition.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 28.16,
      "end": 29.44,
      "text": "It's the goof of all time.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 29.76,
      "end": 31.42,
      "text": "Look, but don't touch.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 33.37,
      "end": 36.07,
      "text": "Touch, but don't taste.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 37.97,
      "end": 39.61,
      "text": "Taste, don't swallow.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 41.41,
      "end": 44.65,
      "text": "And while you're jumping from one foot to the next, what is he doing?",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 45.59,
      "end": 49.11,
      "text": "He's laughing his sick fucking ass off.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 49.43,
      "end": 50.75,
      "text": "He's a tight ass.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 51.09,
      "end": 52.67,
      "text": "He's a sadist.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 53.79,
      "end": 56.17,
      "text": "He's an absentee landlord.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 56.77,
      "end": 58.59,
      "text": "Worship that never.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 59.73,
      "end": 62.23,
      "text": "Better to reign in hell than serve in heaven, is that it?",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 62.95,
      "end": 63.57,
      "text": "Why not?",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 64.41,
      "end": 68.65,
      "text": "I'm here on the ground with my nose in it since the whole thing began.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 69.93,
      "end": 74.25,
      "text": "I've nurtured every sensation man has been inspired to have.",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 74.77,
      "end": 78.41,
      "text": "I cared about what he wanted and I never judged him.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 78.67,
      "end": 78.93,
      "text": "Why?",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 79.17,
      "end": 80.93,
      "text": "Because I never rejected him.",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 81.13,
      "end": 85.21,
      "text": "In spite of all his imperfections, I'm a phantom man.",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 87.3,
      "end": 88.18,
      "text": "I'm a humanist.",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 88.92,
      "end": 90.8,
      "text": "Maybe the last humanist.",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 91.66,
      "end": 99.06,
      "text": "Who in their right mind, Kevin, could possibly deny the 20th century was entirely mine?",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 99.64,
      "end": 101.32,
      "text": "All of it, Kevin.",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 102.44,
      "end": 103.64,
      "text": "All of it.",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 104.7,
      "end": 105.26,
      "text": "Mine.",
      "filename": "segment033.mp4"
    }
  ]
}