  "clip": "The Merchant of Venice.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.54,
      "text": "To bait fish with oil.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 2.62,
      "end": 4.32,
      "text": "If it will feed nothing else,",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 4.72,
      "end": 5.72,
      "text": "it will feed",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 5.72,
      "end": 7.14,
      "text": "my revenge.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 9.58,
      "end": 10.1,
      "text": "He hath",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 10.1,
      "end": 11.22,
      "text": "disgraced me",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 11.92,
      "end": 13.42,
      "text": "and hindered me.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 13.72,
      "end": 14.72,
      "text": "Half a million",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 15.56,
      "end": 17.26,
      "text": "laughed at my losses.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 17.26,
      "end": 19.08,
      "text": "Mocked at my gains.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 19.44,
      "end": 20.68,
      "text": "Scorned my nation.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 21.38,
      "end": 22.58,
      "text": "Thwarted my bargains.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 22.86,
      "end": 23.84,
      "text": "Called my friends.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 24.1,
      "end": 26.18,
      "text": "And what's his reason?",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 26.48,
      "end": 27.26,
      "text": "I am a Jew.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 29.98,
      "end": 30.98,
      "text": "Hath not a Jew eyes?",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 32.18,
      "end": 33.6,
      "text": "Hath not a Jew hands?",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 34.64,
      "end": 35.28,
      "text": "Organs?",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 35.68,
      "end": 36.24,
      "text": "Dimensions?",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 37.36,
      "end": 38.96,
      "text": "Senses? Affections?",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 39.22,
      "end": 39.8,
      "text": "Passions?",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 41.16,
      "end": 42.88,
      "text": "Fed with the same food?",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 44.36,
      "end": 45.32,
      "text": "Hurt with the",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 45.32,
      "end": 46.08,
      "text": "same weapons?",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 46.82,
      "end": 48.64,
      "text": "Subject to the same diseases?",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 49.36,
      "end": 50.86,
      "text": "Healed by the same means?",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 52.1,
      "end": 53.4,
      "text": "Warmed and cooled",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 53.4,
      "end": 55.52,
      "text": "by the same winter and summer",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 55.52,
      "end": 56.9,
      "text": "as a Christian is?",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 57.84,
      "end": 59.52,
      "text": "If you prick us,",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 59.78,
      "end": 60.6,
      "text": "do we not bleed?",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 61.06,
      "end": 63.12,
      "text": "If you tickle us, do we not laugh?",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 64.06,
      "end": 65.2,
      "text": "If you poison us,",
      "filename": "segment033.mp4"
    },
    {
      "index": 34,
      "start": 65.32,
      "end": 66.04,
      "text": "do we not die?",
      "filename": "segment034.mp4"
    },
    {
      "index": 35,
      "start": 67.28,
      "end": 68.52,
      "text": "And if you wrong us,",
      "filename": "segment035.mp4"
    },
    {
      "index": 36,
      "start": 69.28,
      "end": 70.5,
      "text": "shall we not revenge?",
      "filename": "segment036.mp4"
    },
    {
      "index": 37,
      "start": 71.22,
      "end": 72.98,
      "text": "If we are like you in the rest,",
      "filename": "segment037.mp4"
    },
    {
      "index": 38,
      "start": 72.98,
      "end": 74.88,
      "text": "we will resemble you in that.",
      "filename": "segment038.mp4"
    },
    {
      "index": 39,
      "start": 76.88,
      "end": 78.8,
      "text": "If a Jew wronged a Christian,",
      "filename": "segment039.mp4"
    },
    {
      "index": 40,
      "start": 79.38,
      "end": 80.12,
      "text": "what is his humility?",
      "filename": "segment040.mp4"
    },
    {
      "index": 41,
      "start": 81.08,
      "end": 81.6,
      "text": "Revenge?",
      "filename": "segment041.mp4"
    },
    {
      "index": 42,
      "start": 82.24,
      "end": 84.32,
      "text": "If a Christian wronged a Jew,",
      "filename": "segment042.mp4"
    },
    {
      "index": 43,
      "start": 84.66,
      "end": 85.96,
      "text": "what should his sufferings be?",
      "filename": "segment043.mp4"
    },
    {
      "index": 44,
      "start": 86.64,
      "end": 88.02,
      "text": "By Christian example.",
      "filename": "segment044.mp4"
    },
    {
      "index": 45,
      "start": 89.58,
      "end": 90.3,
      "text": "Why revenge?",
      "filename": "segment045.mp4"
    },
    {
      "index": 46,
      "start": 91.68,
      "end": 93.02,
      "text": "The villainy",
      "filename": "segment046.mp4"
    },
    {
      "index": 47,
      "start": 93.02,
      "end": 93.88,
      "text": "you teach me,",
      "filename": "segment047.mp4"
    },
    {
      "index": 48,
      "start": 94.28,
      "end": 95.5,
      "text": "I will execute.",
      "filename": "segment048.mp4"
    },
    {
      "index": 49,
      "start": 96.26,
      "end": 97.72,
      "text": "And it shall go hard,",
      "filename": "segment049.mp4"
    },
    {
      "index": 50,
      "start": 98.12,
      "end": 100.96,
      "text": "but I will bear the instruction.",
      "filename": "segment050.mp4"
    }
  ]
}