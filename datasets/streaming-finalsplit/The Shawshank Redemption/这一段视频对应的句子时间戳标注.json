{
  "lang": "en",
  "film": "The Shawshank Redemption",
  "source_rel": "Greatest Acting Monologues Of All Time PART 1_有史以来最伟大的表演独白 PART 1/Greatest Acting Monologues Of All Time PART 1_有史以来最伟大的表演独白 PART 1.mp4",
  "t_start_global": 467.15,
  "t_end_global": 567.09,
  "duration": 99.94,
  "clip": "The Shawshank Redemption.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 0.48,
      "text": "Were you irritated?",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 3.35,
      "end": 4.35,
      "text": "Well, now let me see.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 5.93,
      "end": 8.21,
      "text": "You know, I don't have any idea what that means.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 10.59,
      "end": 13.09,
      "text": "Well, it means you're ready to rejoin society.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 13.19,
      "end": 14.89,
      "text": "I know what you think it means, sonny.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 17.4,
      "end": 18.88,
      "text": "To me, it's just a made-up word.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 20.68,
      "end": 21.84,
      "text": "A politician's word.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 22.14,
      "end": 28.0,
      "text": "So that young fellas like yourself can wear a suit and a tie and have a job.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 30.39,
      "end": 31.79,
      "text": "But do you really wanna know?",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 33.13,
      "end": 34.77,
      "text": "Am I sorry for what I did?",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 35.71,
      "end": 36.11,
      "text": "Well, are you?",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 38.58,
      "end": 40.66,
      "text": "If not a day goes by, I don't feel regret.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 42.6,
      "end": 45.36,
      "text": "Not because I'm in here or because you think I should.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 49.17,
      "end": 51.11,
      "text": "I look back on the way I was then.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 53.84,
      "end": 58.5,
      "text": "A young, stupid kid who committed that terrible crime.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 62.19,
      "end": 63.15,
      "text": "I wanna talk to him.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 65.75,
      "end": 67.47,
      "text": "I wanna try to talk some sense to him.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 68.87,
      "end": 70.07,
      "text": "Tell him the way things are.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 72.67,
      "end": 73.33,
      "text": "But I can't.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 75.61,
      "end": 77.43,
      "text": "That kid's long gone.",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 78.95,
      "end": 81.01,
      "text": "This old man is all that's left.",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 83.16,
      "end": 84.16,
      "text": "I gotta live with that.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 86.14,
      "end": 86.9,
      "text": "Rehabilitate him.",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 87.76,
      "end": 89.24,
      "text": "It's just a bullshit word.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 90.4,
      "end": 95.02,
      "text": "So you go on and stamp your form, sonny, and stop wasting my time.",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 96.3,
      "end": 99.94,
      "text": "Because to tell you the truth, I don't give a shit.",
      "filename": "segment026.mp4"
    }
  ]
}