{
  "lang": "en",
  "film": "Good Will Hunting",
  "source_rel": "Greatest Acting Monologues Of All Time PART 1_有史以来最伟大的表演独白 PART 1/Greatest Acting Monologues Of All Time PART 1_有史以来最伟大的表演独白 PART 1.mp4",
  "t_start_global": 80.93,
  "t_end_global": 338.3,
  "duration": 257.37,
  "clip": "Good Will Hunting.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 3.58,
      "text": "Thought about what you said to me the other day about my painting.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 4.42,
      "end": 4.82,
      "text": "Ah.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 5.86,
      "end": 7.54,
      "text": "You stood up half the night thinking about it.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 9.84,
      "end": 10.92,
      "text": "Something occurred to me.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 12.18,
      "end": 15.52,
      "text": "I fell into a deep, peaceful sleep, and haven't thought about you since.",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 16.7,
      "end": 17.68,
      "text": "You know what occurred to me?",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 19.72,
      "end": 20.64,
      "text": "You're just a kid.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 21.76,
      "end": 24.18,
      "text": "You don't have the faintest idea what you're talking about.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 24.28,
      "end": 24.86,
      "text": "Why, thank you.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 25.32,
      "end": 25.84,
      "text": "It's all right.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 27.62,
      "end": 28.86,
      "text": "You've never been out of Boston?",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 32.38,
      "end": 32.78,
      "text": "Nope.",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 34.1,
      "end": 35.26,
      "text": "So if I asked you about art,",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 35.26,
      "end": 37.7,
      "text": "you'd probably give me the skinny on every art book ever written.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 39.5,
      "end": 39.94,
      "text": "Michelangelo.",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 41.38,
      "end": 42.38,
      "text": "I know a lot about him.",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 43.24,
      "end": 43.96,
      "text": "Life's work.",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 44.42,
      "end": 45.38,
      "text": "Political aspirations.",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 45.7,
      "end": 46.32,
      "text": "Him and the Pope.",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 46.72,
      "end": 47.7,
      "text": "Sexual orientation.",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 47.859,
      "end": 48.64,
      "text": "The whole works, right?",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 51.37,
      "end": 54.33,
      "text": "I bet you can't tell me what it smells like in the Sistine Chapel.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 57.73,
      "end": 60.79,
      "text": "You've never actually stood there and looked up at that beautiful ceiling.",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 64.67,
      "end": 65.27,
      "text": "Seen that.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 67.45,
      "end": 68.61,
      "text": "If I asked you about women,",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 69.31,
      "end": 71.37,
      "text": "you'd probably give me a silversay of your personal favorites.",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 72.75,
      "end": 74.81,
      "text": "You may have even been laid a few times.",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 81.23,
      "end": 84.21,
      "text": "But you can't tell me what it feels like to wake up next to a woman",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 84.21,
      "end": 85.83,
      "text": "and feel truly happy.",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 90.22,
      "end": 90.9,
      "text": "You're a tough kid.",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 93.99,
      "end": 97.27,
      "text": "If I ask you about war, you'd probably throw Shakespeare at me, right?",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 97.59,
      "end": 99.53,
      "text": "Once more into the breach, dear friends.",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 102.49,
      "end": 103.59,
      "text": "But you've never been near one.",
      "filename": "segment033.mp4"
    },
    {
      "index": 34,
      "start": 105.71,
      "end": 107.59,
      "text": "You've never held your best friend's head in your lap.",
      "filename": "segment034.mp4"
    },
    {
      "index": 35,
      "start": 108.23,
      "end": 111.37,
      "text": "And watched him gasp his last breath, looking to you for help.",
      "filename": "segment035.mp4"
    },
    {
      "index": 36,
      "start": 114.76,
      "end": 115.86,
      "text": "If I ask you about love,",
      "filename": "segment036.mp4"
    },
    {
      "index": 37,
      "start": 116.6,
      "end": 117.6,
      "text": "you'd probably quote me a sonnet.",
      "filename": "segment037.mp4"
    },
    {
      "index": 38,
      "start": 119.72,
      "end": 122.44,
      "text": "But you've never looked at a woman who'd been totally vulnerable.",
      "filename": "segment038.mp4"
    },
    {
      "index": 39,
      "start": 124.22,
      "end": 126.3,
      "text": "Known someone that could level you with her eyes.",
      "filename": "segment039.mp4"
    },
    {
      "index": 40,
      "start": 128.59,
      "end": 131.25,
      "text": "Feeling like God put an angel on earth just for you.",
      "filename": "segment040.mp4"
    },
    {
      "index": 41,
      "start": 133.33,
      "end": 134.97,
      "text": "Who could rescue you from the depths of hell.",
      "filename": "segment041.mp4"
    },
    {
      "index": 42,
      "start": 136.13,
      "end": 137.87,
      "text": "And you wouldn't know what it's like to be her angel.",
      "filename": "segment042.mp4"
    },
    {
      "index": 43,
      "start": 139.33,
      "end": 141.57,
      "text": "To have that love for her be there forever.",
      "filename": "segment043.mp4"
    },
    {
      "index": 44,
      "start": 142.67,
      "end": 143.35,
      "text": "Through anything.",
      "filename": "segment044.mp4"
    },
    {
      "index": 45,
      "start": 144.51,
      "end": 145.25,
      "text": "Through cancer.",
      "filename": "segment045.mp4"
    },
    {
      "index": 46,
      "start": 147.11,
      "end": 150.27,
      "text": "And you wouldn't know about sleeping, sitting up in a hospital room for two months,",
      "filename": "segment046.mp4"
    },
    {
      "index": 47,
      "start": 150.27,
      "end": 151.23,
      "text": "holding her hand.",
      "filename": "segment047.mp4"
    },
    {
      "index": 48,
      "start": 151.77,
      "end": 153.41,
      "text": "Because the doctors could see in your eyes",
      "filename": "segment048.mp4"
    },
    {
      "index": 49,
      "start": 153.41,
      "end": 155.59,
      "text": "that the terms visiting hours don't apply to you.",
      "filename": "segment049.mp4"
    },
    {
      "index": 50,
      "start": 158.35,
      "end": 159.57,
      "text": "You don't know about real loss.",
      "filename": "segment050.mp4"
    },
    {
      "index": 51,
      "start": 160.39,
      "end": 163.71,
      "text": "Because that only occurs when you love something more than you love yourself.",
      "filename": "segment051.mp4"
    },
    {
      "index": 52,
      "start": 165.45,
      "end": 167.97,
      "text": "I doubt you've ever dared to love anybody that much.",
      "filename": "segment052.mp4"
    },
    {
      "index": 53,
      "start": 172.14,
      "end": 172.74,
      "text": "I look at you.",
      "filename": "segment053.mp4"
    },
    {
      "index": 54,
      "start": 173.5,
      "end": 175.8,
      "text": "I don't see an intelligent, confident man.",
      "filename": "segment054.mp4"
    },
    {
      "index": 55,
      "start": 179.25,
      "end": 181.89,
      "text": "I see a cocky, scared, shitless kid.",
      "filename": "segment055.mp4"
    },
    {
      "index": 56,
      "start": 184.42,
      "end": 185.44,
      "text": "But you're a genius, Will.",
      "filename": "segment056.mp4"
    },
    {
      "index": 57,
      "start": 185.84,
      "end": 186.7,
      "text": "No one denies that.",
      "filename": "segment057.mp4"
    },
    {
      "index": 58,
      "start": 187.58,
      "end": 189.92,
      "text": "No one could possibly understand the depths of you.",
      "filename": "segment058.mp4"
    },
    {
      "index": 59,
      "start": 191.34,
      "end": 193.3,
      "text": "But you presume to know everything about me",
      "filename": "segment059.mp4"
    },
    {
      "index": 60,
      "start": 193.3,
      "end": 194.64,
      "text": "because you saw a painting of mine.",
      "filename": "segment060.mp4"
    },
    {
      "index": 61,
      "start": 194.8,
      "end": 196.42,
      "text": "You ripped my fucking life apart.",
      "filename": "segment061.mp4"
    },
    {
      "index": 62,
      "start": 201.37,
      "end": 202.17,
      "text": "You're an orphan, right?",
      "filename": "segment062.mp4"
    },
    {
      "index": 63,
      "start": 207.8,
      "end": 210.9,
      "text": "Do you think I'd know the first thing about how hard your life has been?",
      "filename": "segment063.mp4"
    },
    {
      "index": 64,
      "start": 211.38,
      "end": 212.22,
      "text": "How you feel?",
      "filename": "segment064.mp4"
    },
    {
      "index": 65,
      "start": 212.54,
      "end": 213.24,
      "text": "Who you are?",
      "filename": "segment065.mp4"
    },
    {
      "index": 66,
      "start": 214.04,
      "end": 215.74,
      "text": "Because I read all of a twist?",
      "filename": "segment066.mp4"
    },
    {
      "index": 67,
      "start": 217.36,
      "end": 218.88,
      "text": "Does that encapsulate you?",
      "filename": "segment067.mp4"
    },
    {
      "index": 68,
      "start": 222.98,
      "end": 224.9,
      "text": "Personally, I don't give a shit about all that.",
      "filename": "segment068.mp4"
    },
    {
      "index": 69,
      "start": 225.02,
      "end": 225.58,
      "text": "Because you know what?",
      "filename": "segment069.mp4"
    },
    {
      "index": 70,
      "start": 225.78,
      "end": 227.38,
      "text": "I can't learn anything from you.",
      "filename": "segment070.mp4"
    },
    {
      "index": 71,
      "start": 227.46,
      "end": 229.26,
      "text": "I can't read in some fucking book.",
      "filename": "segment071.mp4"
    },
    {
      "index": 72,
      "start": 231.49,
      "end": 232.97,
      "text": "Unless you want to talk about you.",
      "filename": "segment072.mp4"
    },
    {
      "index": 73,
      "start": 233.59,
      "end": 234.65,
      "text": "Who you are.",
      "filename": "segment073.mp4"
    },
    {
      "index": 74,
      "start": 237.19,
      "end": 238.15,
      "text": "And I'm fascinated.",
      "filename": "segment074.mp4"
    },
    {
      "index": 75,
      "start": 239.75,
      "end": 240.33,
      "text": "I'm in.",
      "filename": "segment075.mp4"
    },
    {
      "index": 76,
      "start": 243.03,
      "end": 244.71,
      "text": "But you don't want to do that through your sport.",
      "filename": "segment076.mp4"
    },
    {
      "index": 77,
      "start": 248.99,
      "end": 250.47,
      "text": "You're terrified of what you might say.",
      "filename": "segment077.mp4"
    },
    {
      "index": 78,
      "start": 256.73,
      "end": 257.37,
      "text": "You're moved, Chief.",
      "filename": "segment078.mp4"
    }
  ]
}