{
  "lang": "en",
  "film": "The Fresh Prince of Bel-Air",
  "source_rel": "Greatest Acting Monologues Of All Time PART 1_有史以来最伟大的表演独白 PART 1/Greatest Acting Monologues Of All Time PART 1_有史以来最伟大的表演独白 PART 1.mp4",
  "t_start_global": 811.78,
  "t_end_global": 893.74,
  "duration": 81.96,
  "clip": "The Fresh Prince of Bel-Air.mp4",
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.04,
      "text": "I'm sorry, Will.",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 1.86,
      "end": 2.42,
      "text": "You know what?",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 2.54,
      "end": 3.7,
      "text": "Actually, this works out better for me.",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 3.8,
      "end": 5.96,
      "text": "You know, the slimmies of summer come to class wearing next to nothing.",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 6.08,
      "end": 6.28,
      "text": "You know what I'm saying?",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 6.28,
      "end": 7.64,
      "text": "Will, it's all right to be angry.",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 8.5,
      "end": 9.78,
      "text": "Hey, why should I be mad?",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 10.38,
      "end": 12.14,
      "text": "I'm saying at least he said goodbye this time.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 12.7,
      "end": 16.08,
      "text": "I just wish I hadn't wasted my money buying this stupid present.",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 19.04,
      "end": 19.66,
      "text": "I'm sorry.",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 19.82,
      "end": 21.84,
      "text": "You know, if there was something that I could do.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 21.84,
      "end": 22.32,
      "text": "Hey, you know what?",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 22.48,
      "end": 23.8,
      "text": "You ain't got to do nothing, Uncle Phil.",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 23.9,
      "end": 26.2,
      "text": "Hey, you know, ain't like I'm still five years old, you know?",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 26.5,
      "end": 29.08,
      "text": "Ain't like I'm gonna be sitting up every night asking my mom,",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 29.18,
      "end": 30.42,
      "text": "when's daddy coming home, you know?",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 30.56,
      "end": 31.28,
      "text": "Who needs him?",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 31.28,
      "end": 34.46,
      "text": "Hey, he wasn't there to teach me how to shoot my first basket, but I learned, didn't I?",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 34.72,
      "end": 36.66,
      "text": "Hey, I got a pretty damn good attitude, didn't I, Uncle Phil?",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 36.82,
      "end": 38.74,
      "text": "Got through my first day without him, right?",
      "filename": "segment020.mp4"
    },
    {
      "index": 21,
      "start": 38.94,
      "end": 40.04,
      "text": "I learned how to drive.",
      "filename": "segment021.mp4"
    },
    {
      "index": 22,
      "start": 40.18,
      "end": 41.04,
      "text": "I learned how to shave.",
      "filename": "segment022.mp4"
    },
    {
      "index": 23,
      "start": 41.16,
      "end": 42.24,
      "text": "I learned how to fight without him.",
      "filename": "segment023.mp4"
    },
    {
      "index": 24,
      "start": 42.44,
      "end": 45.3,
      "text": "I had 14 great birthdays without him.",
      "filename": "segment024.mp4"
    },
    {
      "index": 25,
      "start": 45.5,
      "end": 46.92,
      "text": "He never even sent me a damn car.",
      "filename": "segment025.mp4"
    },
    {
      "index": 26,
      "start": 47.24,
      "end": 55.93,
      "text": "I ain't need him then, and I don't need him now.",
      "filename": "segment026.mp4"
    },
    {
      "index": 27,
      "start": 56.65,
      "end": 56.97,
      "text": "Will.",
      "filename": "segment027.mp4"
    },
    {
      "index": 28,
      "start": 57.19,
      "end": 58.09,
      "text": "You know what, Uncle Phil?",
      "filename": "segment028.mp4"
    },
    {
      "index": 29,
      "start": 58.67,
      "end": 60.13,
      "text": "I'm gonna get through college without him.",
      "filename": "segment029.mp4"
    },
    {
      "index": 30,
      "start": 60.65,
      "end": 62.25,
      "text": "I'm gonna get a great job without him.",
      "filename": "segment030.mp4"
    },
    {
      "index": 31,
      "start": 62.49,
      "end": 65.41,
      "text": "I'm gonna marry me a beautiful honey, and I'm having a whole bunch of kids.",
      "filename": "segment031.mp4"
    },
    {
      "index": 32,
      "start": 65.41,
      "end": 67.29,
      "text": "I'm gonna be a better father than he ever was.",
      "filename": "segment032.mp4"
    },
    {
      "index": 33,
      "start": 67.49,
      "end": 68.83,
      "text": "And I sure as hell don't need him for that,",
      "filename": "segment033.mp4"
    },
    {
      "index": 34,
      "start": 68.99,
      "end": 72.61,
      "text": "because ain't a damn thing he could ever teach me about how to love my kids.",
      "filename": "segment034.mp4"
    },
    {
      "index": 35,
      "start": 80.36,
      "end": 81.96,
      "text": "How come you don't want me, man?",
      "filename": "segment035.mp4"
    }
  ]
}