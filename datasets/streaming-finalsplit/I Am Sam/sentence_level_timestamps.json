  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 9.32,
      "text": "I have had a lot of time to think about what it is",
      "filename": "segment001.mp4"
    },
    {
      "index": 2,
      "start": 9.98,
      "end": 12.92,
      "text": "that makes somebody a good parent.",
      "filename": "segment002.mp4"
    },
    {
      "index": 3,
      "start": 14.06,
      "end": 17.14,
      "text": "And it's about constancy",
      "filename": "segment003.mp4"
    },
    {
      "index": 4,
      "start": 17.98,
      "end": 20.02,
      "text": "and it's about patience",
      "filename": "segment004.mp4"
    },
    {
      "index": 5,
      "start": 26.26,
      "end": 27.9,
      "text": "and it's about listening",
      "filename": "segment005.mp4"
    },
    {
      "index": 6,
      "start": 29.02,
      "end": 32.68,
      "text": "and it's about and it's about pretending to listen",
      "filename": "segment006.mp4"
    },
    {
      "index": 7,
      "start": 32.68,
      "end": 35.1,
      "text": "even when you can't listen anymore.",
      "filename": "segment007.mp4"
    },
    {
      "index": 8,
      "start": 37.38,
      "end": 40.1,
      "text": "And it's about love, like she said.",
      "filename": "segment008.mp4"
    },
    {
      "index": 9,
      "start": 41.08,
      "end": 43.52,
      "text": "See, Billy has a home with me",
      "filename": "segment009.mp4"
    },
    {
      "index": 10,
      "start": 43.52,
      "end": 46.18,
      "text": "and I made it the best I could",
      "filename": "segment010.mp4"
    },
    {
      "index": 11,
      "start": 46.18,
      "end": 48.26,
      "text": "and it's not perfect.",
      "filename": "segment011.mp4"
    },
    {
      "index": 12,
      "start": 49.04,
      "end": 51.54,
      "text": "And I'm not a perfect parent",
      "filename": "segment012.mp4"
    },
    {
      "index": 13,
      "start": 52.1,
      "end": 55.08,
      "text": "and sometimes I don't have enough patience",
      "filename": "segment013.mp4"
    },
    {
      "index": 14,
      "start": 55.08,
      "end": 57.62,
      "text": "and I forget he's just a little kid.",
      "filename": "segment014.mp4"
    },
    {
      "index": 15,
      "start": 59.48,
      "end": 62.7,
      "text": "But we built a life together",
      "filename": "segment015.mp4"
    },
    {
      "index": 16,
      "start": 63.78,
      "end": 65.52,
      "text": "and we love each other",
      "filename": "segment016.mp4"
    },
    {
      "index": 17,
      "start": 66.2,
      "end": 68.54,
      "text": "and if you destroy that",
      "filename": "segment017.mp4"
    },
    {
      "index": 18,
      "start": 69.44,
      "end": 70.72,
      "text": "it'll be",
      "filename": "segment018.mp4"
    },
    {
      "index": 19,
      "start": 71.54,
      "end": 74.6,
      "text": "it'll be irre... irre... irre...",
      "filename": "segment019.mp4"
    },
    {
      "index": 20,
      "start": 74.6,
      "end": 75.14,
      "text": "What am I saying?",
      "filename": "segment020.mp4"
    }
  ]
}